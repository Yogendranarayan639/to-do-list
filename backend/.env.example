# Server Port
PORT=5001

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/todo_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/todo_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/todo_db

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
